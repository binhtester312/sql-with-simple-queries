<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  testng-login.xml
  Suite riêng cho LoginTest — dùng bởi CI/CD job: test-login
  parallel="methods" → mỗi @Test case chạy trên 1 thread riêng
  thread-count="3"   → chạy tối đa 3 test case CÙNG LÚC
-->
<suite name="Login Suite" parallel="methods" thread-count="3">
    <listeners>
        <listener class-name="com.nopcommerce.listeners.AllureListener" />
    </listeners>
    <test name="Login Tests">
        <classes>
            <class name="com.nopcommerce.tests.LoginTest" />
        </classes>
    </test>
</suite>
