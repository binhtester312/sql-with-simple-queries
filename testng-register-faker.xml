<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  testng-register-faker.xml
  Suite riêng cho RegisterTest_JavaFaker — dùng bởi CI/CD job: test-register-faker
-->
<suite name="Register Faker Suite" parallel="methods" thread-count="3">
    <listeners>
        <listener class-name="com.nopcommerce.listeners.AllureListener" />
    </listeners>
    <test name="Register JavaFaker Tests">
        <classes>
            <class name="com.nopcommerce.tests.RegisterTest_JavaFaker" />
        </classes>
    </test>
</suite>
